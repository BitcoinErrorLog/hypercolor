{
  "name": "hypercolor",
  "version": "1.0.0",
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'modules/**/*.{ts,tsx}' 'vrt/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' 'modules/**/*.{ts,tsx}' 'vrt/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,json}' 'modules/**/*.{ts,tsx}' 'vrt/**/*.{ts,tsx}'",
    "test": "jest",
    "test:e2e": "maestro test .maestro/p7-product.yaml",
    "vrt:catalog": "E2E_VRT=1 tsx vrt/runCatalog.ts",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "prepare": "husky",
    "vrt:integrity": "tsx vrt/integrityGate.ts vrt/baselines/ios vrt/output/report/marker-ledger-ios.json vrt/output/report/integrity-ios.json",
    "vrt:capture:android": "bash scripts/vrt-capture-android.sh",
    "vrt:capture:ios": "bash scripts/vrt-capture-ios.sh"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.3",
    "@noble/hashes": "1.8.0",
    "@op-engineering/op-sqlite": "^15.2.5",
    "@react-navigation/bottom-tabs": "^7.14.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.13.0",
    "@scure/base": "^1",
    "@synonymdev/react-native-pubky": "^0.11.1",
    "buffer": "^6.0.3",
    "expo": "~54.0.33",
    "expo-camera": "~17.0.10",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "14.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-modules-core": "^3.0.29",
    "expo-status-bar": "~3.0.9",
    "immer": "^11.1.4",
    "light-bolt11-decoder": "^3.2.0",
    "mesh-transport": "file:./modules/mesh-transport",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-get-random-values": "^2.0.0",
    "react-native-keychain": "^10.0.0",
    "react-native-mmkv": "^4.1.2",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.23.0",
    "uuid": "^13.0.0",
    "zustand": "^5.0.11"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-native": "^0.72.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "babel-preset-expo": "~54.0.10",
    "better-sqlite3": "^13.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.0",
    "lint-staged": "^16.2.7",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
